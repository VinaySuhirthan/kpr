# Backend configuration template
# Copy this file to .env and set your PostgreSQL credentials there.

PORT=5000

# Required PostgreSQL connection settings
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=hacksamr
PG_USER=postgres
PG_PASSWORD=your_secure_password_here

# Optional connection pool settings
PG_MAX_CONNECTIONS=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=2000
