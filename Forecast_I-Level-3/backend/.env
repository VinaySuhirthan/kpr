# NCBI AMRFinderPlus Configuration
# Specify the command or full path to the amrfinder executable:
# Examples:
#   AMRFINDERPLUS_PATH=amrfinder
#   AMRFINDERPLUS_PATH=C:\Users\username\miniconda3\envs\amr\Scripts\amrfinder.exe
#   AMRFINDERPLUS_PATH=/usr/local/bin/amrfinder
AMRFINDERPLUS_PATH=amrfinder

# Optional path to local AMRFinderPlus reference database directory:
# AMRFINDERPLUS_DB=/path/to/amrfinder/data

# Server settings
DEBUG=false
